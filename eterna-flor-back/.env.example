# Pooled connection string from the Neon dashboard (host contains "-pooler").
# Used by the application at runtime; connections go through Neon's connection pooler.
DATABASE_URL="postgresql://your-neon-user:your-neon-password@ep-cool-name-123456-pooler.us-east-2.aws.neon.tech/eternaflor?schema=public&sslmode=require"

# Direct connection string from the Neon dashboard (host has no "-pooler").
# Required by `prisma migrate deploy` because migrations cannot run through a connection pooler.
DIRECT_URL="postgresql://your-neon-user:your-neon-password@ep-cool-name-123456.us-east-2.aws.neon.tech/eternaflor?schema=public&sslmode=require"

# Strong random secret for signing JWTs. Generate with `openssl rand -base64 48`.
JWT_SECRET="your-jwt-secret-here"

# Exact public origin of the deployed frontend; used for CORS configuration.
FRONTEND_URL="https://your-frontend-domain.com"

# Cloudinary account credentials for image uploads.
CLOUDINARY_CLOUD_NAME="your-cloud-name-here"
CLOUDINARY_API_KEY="your-api-key-here"
CLOUDINARY_API_SECRET="your-api-secret-here"

# Port the NestJS backend listens on.
PORT=3001

# Runtime environment: development, staging, or production.
NODE_ENV=production

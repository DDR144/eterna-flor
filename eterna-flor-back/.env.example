# Neon pooled connection string used by the app at runtime.
# Format: postgresql://<user>:<password>@<pooled-host>/<database>?schema=public
DATABASE_URL="postgresql://your-neon-user:your-neon-password@your-pooled-neon-host.eternaflor?schema=public"

# Neon direct/unpooled connection string used only by `prisma migrate deploy`.
# Must point to the same database as DATABASE_URL but without connection pooling.
DIRECT_URL="postgresql://your-neon-user:your-neon-password@your-direct-neon-host.eternaflor?schema=public"

# Strong random secret for signing JWTs. Generate with `openssl rand -base64 48`.
JWT_SECRET="your-jwt-secret-here"

# Exact public origin of the deployed frontend; used for CORS configuration.
FRONTEND_URL="https://your-frontend-domain.com"

# Cloudinary account credentials for image uploads.
CLOUDINARY_CLOUD_NAME="your-cloud-name-here"
CLOUDINARY_API_KEY="your-api-key-here"
CLOUDINARY_API_SECRET="your-api-secret-here"

# Port the NestJS backend listens on.
PORT=3001

# Runtime environment: development, staging, or production.
NODE_ENV=production
